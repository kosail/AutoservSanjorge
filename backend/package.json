{
  "name": "taller-backend",
  "version": "1.0.0",
  "description": "Backend mínimo para guardar cotizaciones",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "migrate:supabase": "node scripts/run_migrations.js",
    "test": "node --test tests/*.test.js",
    "pretest:ci": "node -e \"require('fs').mkdirSync('test-results',{recursive:true})\"",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/junit.xml tests/*.test.js",
    "migrate:all": "node scripts/run_migrations.js",
    "validate:schema": "node scripts/validate_schema.js",
    "smoke:test": "node scripts/smoke_test.js",
    "wait:db": "node scripts/wait_for_db.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.6.0",
    "pdfkit": "0.20.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "pdf-parse": "^2.4.5"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
