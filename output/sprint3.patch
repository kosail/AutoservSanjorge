+    'xl/workbook.xml': `<workbook xmlns="${hoja}" xmlns:r="${relacion}"><sheets>
+      <sheet name="Ventas diarias" sheetId="1" r:id="rId1"/>
+    </sheets></workbook>`,
+    'xl/_rels/workbook.xml.rels': relaciones([['worksheet', 'worksheets/sheet1.xml']]),
+    'xl/worksheets/sheet1.xml': `<worksheet xmlns="${hoja}" xmlns:r="${relacion}">
+      <cols><col min="1" max="1" width="26" customWidth="1"/><col min="2" max="2" width="30" customWidth="1"/>
+      <col min="3" max="3" width="54" customWidth="1"/><col min="4" max="6" width="19" customWidth="1"/></cols>
+      <sheetData>${datos}</sheetData><drawing r:id="rId1"/>
+    </worksheet>`,
+    'xl/worksheets/_rels/sheet1.xml.rels': relaciones([['drawing', '../drawings/drawing1.xml']]),
+    'xl/drawings/drawing1.xml': `<xdr:wsDr xmlns:xdr="${dibujo}" xmlns:a="${dibujoBase}" xmlns:r="${relacion}">
